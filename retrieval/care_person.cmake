add_library(care_person STATIC "${CMAKE_CURRENT_LIST_DIR}/care_person.cpp")
target_include_directories(care_person PUBLIC "${CMAKE_CURRENT_LIST_DIR}/../include" PRIVATE "${CMAKE_CURRENT_LIST_DIR}")
target_compile_features(care_person PUBLIC cxx_std_17)
target_link_libraries(care_person PUBLIC care_algorithm_core)
target_compile_options(care_person PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
if(BUILD_TESTING)
    find_package(Qt6 REQUIRED COMPONENTS Test)
    add_executable(care_person_tests "${CMAKE_CURRENT_LIST_DIR}/care_person_tests.cpp")
    set_target_properties(care_person_tests PROPERTIES AUTOMOC ON)
    target_link_libraries(care_person_tests PRIVATE care_person Qt6::Test)
    target_compile_options(care_person_tests PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
    add_test(NAME care_person COMMAND care_person_tests)
endif()
