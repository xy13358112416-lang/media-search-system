find_package(Qt6 REQUIRED COMPONENTS Core)
add_library(care_algorithm_core STATIC "${CMAKE_CURRENT_LIST_DIR}/care_algorithm_common.cpp")
target_include_directories(care_algorithm_core PUBLIC "${CMAKE_CURRENT_LIST_DIR}/../include" "${CMAKE_CURRENT_LIST_DIR}")
target_compile_features(care_algorithm_core PUBLIC cxx_std_17)
target_link_libraries(care_algorithm_core PUBLIC care_contract Qt6::Core)
target_compile_options(care_algorithm_core PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
if(BUILD_TESTING)
    find_package(Qt6 REQUIRED COMPONENTS Test)
    add_executable(care_algorithm_common_tests "${CMAKE_CURRENT_LIST_DIR}/care_algorithm_common_tests.cpp")
    set_target_properties(care_algorithm_common_tests PROPERTIES AUTOMOC ON)
    target_link_libraries(care_algorithm_common_tests PRIVATE care_algorithm_core Qt6::Test)
    target_compile_options(care_algorithm_common_tests PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
    add_test(NAME care_algorithm_common COMMAND care_algorithm_common_tests)
endif()
