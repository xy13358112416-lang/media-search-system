# Server-only optional module; include after shared care_contract is available.
find_package(Qt6 REQUIRED COMPONENTS Core Network)
add_library(llm_trend_summary STATIC "${CMAKE_CURRENT_LIST_DIR}/llm_trend_summary.cpp")
target_include_directories(llm_trend_summary PUBLIC "${CMAKE_CURRENT_LIST_DIR}" "${CMAKE_CURRENT_LIST_DIR}/../include")
target_compile_features(llm_trend_summary PUBLIC cxx_std_17)
target_link_libraries(llm_trend_summary PUBLIC Qt6::Core Qt6::Network)
target_compile_options(llm_trend_summary PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
if(BUILD_TESTING)
    find_package(Qt6 REQUIRED COMPONENTS Test)
    add_executable(llm_trend_summary_tests "${CMAKE_CURRENT_LIST_DIR}/llm_trend_summary_tests.cpp")
    set_target_properties(llm_trend_summary_tests PROPERTIES AUTOMOC ON)
    target_link_libraries(llm_trend_summary_tests PRIVATE llm_trend_summary Qt6::Test)
    target_compile_options(llm_trend_summary_tests PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
    add_test(NAME llm_trend_summary COMMAND llm_trend_summary_tests)
endif()
